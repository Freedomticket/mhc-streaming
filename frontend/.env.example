# MHC Streaming - Frontend Environment Configuration
# Copy this file to .env.local and fill in your values

# API Configuration
# Backend API Gateway URL (primary entry point for all API calls)
# Production: https://mhc-api-gateway.onrender.com
# Development: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Individual Service URLs (for direct access if needed)
# Auth Service - Production: https://mhc-auth-service.onrender.com
NEXT_PUBLIC_AUTH_URL=http://localhost:3001
# Media Service - Production: https://mhc-media-service.onrender.com
NEXT_PUBLIC_MEDIA_URL=http://localhost:3002
# Payment Service - Production: https://mhc-payment-service.onrender.com
NEXT_PUBLIC_PAYMENT_URL=http://localhost:3004

# WebSocket URL for real-time features (default: ws://localhost:3000)
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# Application Configuration
NEXT_PUBLIC_APP_NAME="MHC Streaming"
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Feature Flags
NEXT_PUBLIC_ENABLE_LIVESTREAM=true
NEXT_PUBLIC_ENABLE_COMMENTS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# External Services (Optional)
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-...

# Development
NODE_ENV=development
